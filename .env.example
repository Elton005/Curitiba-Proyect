# Public frontend configuration. Leave blank until confirmed by the owner.
# Do not put API keys, passwords or other secrets in VITE_* variables.
VITE_SITE_ORIGIN=
# WhatsApp confirmed by the owner is centralized in src/data/config.js.
# No environment override: keep the exact authorized destination.
VITE_CONTACT_EMAIL=
# Public HTTPS URL of a verified standalone Android Release APK. No Debug APK.
VITE_APP_DOWNLOAD_URL=
# Set true only AFTER checking accessibility, package ID, signature, ABI,
# embedded JavaScript and Release manifest of that exact public APK.
# Empty URL or false keeps "Conhecer o Loop Ação" as the main CTA.
VITE_APP_DOWNLOAD_RELEASE_VERIFIED=false
